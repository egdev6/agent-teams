{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Build Once",
      "type": "shell",
      "command": "pnpm build:core && pnpm --filter @agent-teams/webviews build && pnpm --filter @agent-teams/extension build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Dev: Start Watches Integrated",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .vscode/start-integrated-watch.ps1",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "message": 0
        },
        "background": {
          "activeOnStart": false,
          "beginsPattern": "^DEV_WATCH_BEGIN$",
          "endsPattern": "^DEV_WATCH_READY$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "Dev: Stop Watches",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .vscode/stop-dev-watch.ps1",
      "problemMatcher": []
    },
    {
      "label": "Dev: Build + Start Watches",
      "dependsOrder": "sequence",
      "dependsOn": ["Dev: Build Once", "Dev: Start Watches Integrated"],
      "problemMatcher": []
    }
  ]
}
