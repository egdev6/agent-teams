{
  "name": "agent-teams-monorepo",
  "version": "1.0.0",
  "description": "Kits & Teams system for GitHub Copilot - Reusable agent bundles with intelligent composition",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --parallel run \"/^dev:(webviews|extension)$/\"",
    "dev:webviews": "pnpm --filter \"@agent-teams/webviews\" dev",
    "dev:extension": "pnpm --filter \"agent-teams\" watch",
    "build": "pnpm build:core && pnpm build:webviews && pnpm build:cli && pnpm build:extension",
    "build:core": "pnpm --filter @agent-teams/core build",
    "build:webviews": "pnpm --filter @agent-teams/webviews build",
    "build:extension": "pnpm --filter agent-teams build",
    "build:cli": "pnpm --filter @agent-teams/cli build",
    "package:test": "pnpm build:core && pnpm build:webviews && pnpm --filter agent-teams package:test",
    "lint": "biome check . --write --staged --unsafe --verbose --files-ignore-unknown=true",
    "lint:all": "biome check . --verbose --files-ignore-unknown=true",
    "lint:all:fix": "biome check . --write --unsafe --verbose --files-ignore-unknown=true",
    "lint:fix": "biome lint --apply .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check --apply .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @agent-teams/core test && pnpm --filter agent-teams test",
    "test:watch": "pnpm --filter agent-teams test:watch",
    "test:e2e": "pnpm --filter @agent-teams/webviews test:e2e",
    "test:e2e:ui": "pnpm --filter @agent-teams/webviews test:e2e:ui",
    "typecheck:all": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive clean && rimraf dist coverage",
    "clean:all": "pwsh scripts/clean.ps1",
    "reinstall": "pwsh scripts/clean.ps1 -Reinstall",
    "agents": "pnpm --filter @agent-teams/cli start",
    "agents:dev": "pnpm --filter @agent-teams/cli dev",
    "changeset": "node scripts/changeset-add.cjs",
    "release:version": "changeset version && node scripts/sync-root-changelog.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "ajv": "^8.18.0",
    "concurrently": "^9.2.1",
    "js-yaml": "^4.1.1",
    "lefthook": "^2.1.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0"
  }
}
