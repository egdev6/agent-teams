{
  "name": "agent-teams-monorepo",
  "version": "2.0.0",
  "description": "Kits & Teams system for GitHub Copilot - Reusable agent bundles with intelligent composition",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --parallel run \"/^dev:(webviews|extension)$/\"",
    "dev:webviews": "pnpm --filter \"@agent-teams/webviews\" dev",
    "dev:extension": "pnpm --filter \"@agent-teams/extension\" watch",
    "build": "pnpm build:core && concurrently -n webviews,extension,cli -c cyan,blue,magenta \"pnpm build:webviews\" \"pnpm build:extension\" \"pnpm build:cli\"",
    "build:core": "pnpm --filter @agent-teams/core build",
    "build:webviews": "pnpm --filter @agent-teams/webviews build",
    "build:extension": "pnpm --filter @agent-teams/extension build",
    "build:cli": "pnpm --filter @agent-teams/cli build",
    "lint": "biome check . --write --staged --verbose --files-ignore-unknown=true",
    "lint:fix": "biome lint --apply .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "biome check --apply .",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm --recursive typecheck",
    "clean": "pnpm --recursive clean && rimraf dist coverage",
    "agents": "pnpm --filter @agent-teams/cli start",
    "agents:dev": "pnpm --filter @agent-teams/cli dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.16",
    "ajv": "^8.12.0",
    "concurrently": "^9.2.1",
    "js-yaml": "^4.1.1",
    "lefthook": "^1.6.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "yaml": "^2.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
