{
  "name": "agent-teams-extension",
  "displayName": "Agent Teams",
  "description": "Kits & Teams system for GitHub Copilot - Create reusable agent teams with dynamic composition",
  "version": "2.0.0",
  "publisher": "your-publisher-name",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agent-teams.reloadAgents",
        "title": "Agent Teams: Reload Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-teams.selectAgent",
        "title": "Agent Teams: Select Agent Manually",
        "icon": "$(list-selection)"
      },
      {
        "command": "agent-teams.createAgent",
        "title": "Agent Teams: Create New Agent",
        "icon": "$(add)"
      },
      {
        "command": "agent-teams.syncAgents",
        "title": "Agent Teams: Sync Agents to .github/",
        "icon": "$(sync)"
      },
      {
        "command": "agent-teams.createFromSpec",
        "title": "Agent Teams: Generate Agent from Spec",
        "icon": "$(file-code)"
      },
      {
        "command": "agent-teams.initProfile",
        "title": "Agent Teams: Initialize Project Profile (v2.0)",
        "icon": "$(new-folder)"
      },
      {
        "command": "agent-teams.createTeam",
        "title": "Agent Teams: Create Team Profile (v2.0)",
        "icon": "$(organization)"
      },
      {
        "command": "agent-teams.listTeams",
        "title": "Agent Teams: List Teams (v2.0)",
        "icon": "$(list-tree)"
      },
      {
        "command": "agent-teams.syncTeam",
        "title": "Agent Teams: Sync Team to .github/ (v2.0)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agent-teams.browseKits",
        "title": "Agent Teams: Browse Available Kits (v2.0)",
        "icon": "$(package)"
      },
      {
        "command": "agent-teams.openKitBrowser",
        "title": "Agent Teams: Open Kit Browser (v2.0)",
        "icon": "$(browser)"
      },
      {
        "command": "agent-teams.openDashboard",
        "title": "Agent Teams: Open Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .yml || resourceExtname == .yaml",
          "command": "agent-teams.createFromSpec",
          "group": "agent-teams@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agent-teams.createFromSpec",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Agent Teams",
      "properties": {
        "agentTeams.agentsPath": {
          "type": "string",
          "default": ".github/agents",
          "description": "Path to agents directory relative to workspace root"
        },
        "agentTeams.enableAutoRouting": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic intent-based routing"
        },
        "agentTeams.enablePathMatching": {
          "type": "boolean",
          "default": true,
          "description": "Enable path-based agent activation"
        },
        "agentTeams.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for agent-teams extension"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "npm run build:webviews && npm run compile",
    "build:webviews": "cd webviews && pnpm run build",
    "watch": "tsc -watch -p ./",
    "watch:webviews": "cd webviews && pnpm run watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "vitest": "^4.0.18",
    "yaml": "^2.3.4"
  }
}
