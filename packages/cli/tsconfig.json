{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@agent-teams/extension": ["../extension/dist/extension.js"],
      "@agent-teams/extension/*": ["../extension/dist/*"],
      "@agent-teams/core": ["../core/dist/index.d.ts"],
      "@agent-teams/core/*": ["../core/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "references": [{ "path": "../core" }, { "path": "../extension" }]
}
