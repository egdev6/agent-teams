{
  "name": "@agent-teams/cli",
  "version": "1.0.3",
  "description": "CLI tools for Agent Teams - Create, validate, and sync agents",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "agent-teams": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc --build --force",
    "start": "node dist/cli.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent-teams",
    "cli",
    "github-copilot",
    "ai-agents"
  ],
  "dependencies": {
    "@agent-teams/core": "workspace:*",
    "agent-teams": "workspace:*",
    "commander": "^14.0.3",
    "chalk": "^5.3.0",
    "ora": "^9.3.0",
    "inquirer": "^13.2.5",
    "ajv": "^8.12.0",
    "yaml": "^2.2.1",
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/inquirer": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
