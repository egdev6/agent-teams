{
  "name": "@agent-teams/cli",
  "version": "2.0.0",
  "description": "CLI tools for Agent Teams - Create, validate, and sync agents",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "agent-teams": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc --build",
    "start": "node dist/cli.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent-teams",
    "cli",
    "github-copilot",
    "ai-agents"
  ],
  "dependencies": {
    "@agent-teams/core": "workspace:*",
    "@agent-teams/extension": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.12",
    "ajv": "^8.12.0",
    "js-yaml": "^4.1.1",
    "yaml": "^2.2.1",
    "chokidar": "^3.5.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.16",
    "@types/inquirer": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
