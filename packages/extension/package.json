{
  "name": "agent-teams",
  "displayName": "Agent Teams",
  "description": "Kits & Teams system for GitHub Copilot - Create reusable agent teams with dynamic composition",
  "version": "1.0.0",
  "publisher": "egdev6",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTeams",
          "title": "Agent Teams",
          "icon": "media/agent-teams.svg"
        }
      ]
    },
    "views": {
      "agentTeams": [
        {
          "icon": "media/agent-teams.svg",
          "id": "agentTeams.sidebar",
          "name": "Dashboard"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentTeams.sidebar",
        "contents": "[Open Agent Teams Dashboard](command:agent-teams.openDashboard)"
      }
    ],
    "commands": [
      {
        "command": "agent-teams.reloadAgents",
        "title": "Agent Teams: Reload Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-teams.selectAgent",
        "title": "Agent Teams: Select Agent Manually",
        "icon": "$(list-selection)"
      },
      {
        "command": "agent-teams.createAgent",
        "title": "Agent Teams: Create New Agent",
        "icon": "$(add)"
      },
      {
        "command": "agent-teams.syncAgents",
        "title": "Agent Teams: Sync Agents to .github/",
        "icon": "$(sync)"
      },
      {
        "command": "agent-teams.createFromSpec",
        "title": "Agent Teams: Generate Agent from Spec",
        "icon": "$(file-code)"
      },
      {
        "command": "agent-teams.initProfile",
        "title": "Agent Teams: Initialize Project Profile (v2.0)",
        "icon": "$(new-folder)"
      },
      {
        "command": "agent-teams.createTeam",
        "title": "Agent Teams: Create Team Profile (v2.0)",
        "icon": "$(organization)"
      },
      {
        "command": "agent-teams.listTeams",
        "title": "Agent Teams: List Teams (v2.0)",
        "icon": "$(list-tree)"
      },
      {
        "command": "agent-teams.syncTeam",
        "title": "Agent Teams: Sync Team to .github/ (v2.0)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agent-teams.browseKits",
        "title": "Agent Teams: Browse Available Kits (v2.0)",
        "icon": "$(package)"
      },
      {
        "command": "agent-teams.openKitBrowser",
        "title": "Agent Teams: Open Kit Browser (v2.0)",
        "icon": "$(browser)"
      },
      {
        "command": "agent-teams.openDashboard",
        "title": "Agent Teams: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "agent-teams.setupEngram",
        "title": "Agent Teams: Setup Engram Memory",
        "icon": "$(database)"
      },
      {
        "command": "agent-teams.captureWorkspaceCatalog",
        "title": "Agent Teams: Capture Workspace into Catalog",
        "icon": "$(archive)"
      },
      {
        "command": "agent-teams.exportCatalog",
        "title": "Agent Teams: Export Catalog",
        "icon": "$(export)"
      },
      {
        "command": "agent-teams.importCatalog",
        "title": "Agent Teams: Import Catalog",
        "icon": "$(import)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .yml || resourceExtname == .yaml",
          "command": "agent-teams.createFromSpec",
          "group": "agent-teams@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agent-teams.createFromSpec",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "agent-teams.captureWorkspaceCatalog",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "agent-teams.exportCatalog"
        },
        {
          "command": "agent-teams.importCatalog"
        },
        {
          "command": "agent-teams.setupEngram",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Agent Teams",
      "properties": {
        "agentTeams.agentsPath": {
          "type": "string",
          "default": ".github/agents",
          "description": "Path to agents directory relative to workspace root"
        },
        "agentTeams.enableAutoRouting": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic intent-based routing"
        },
        "agentTeams.enablePathMatching": {
          "type": "boolean",
          "default": true,
          "description": "Enable path-based agent activation"
        },
        "agentTeams.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for agent-teams extension"
        },
        "agentTeams.skillsLcApiKey": {
          "type": "string",
          "default": "sk_live_CynEY6qDPHeUzN655YIQJR7QEzT6qFcLhbKtksVNHYM",
          "markdownDescription": "API key for [skills.lc](https://skills.lc) community search. Without a key the public catalog is used with client-side filtering. Get a key at skills.lc/settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "compile": "tsc --build --force ./",
    "postcompile": "pnpm run copy-webviews",
    "copy-webviews": "node ./scripts/copy-webviews.cjs",
    "build": "pnpm run compile",
    "watch": "tsc --build --watch ./",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@agent-teams/webviews": "workspace:*",
    "@agent-teams/core": "workspace:*",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.3.4"
  }
}
