# .vscodeignore for extension packaging
.vscode/**
.vscode-test/**
src/**
.gitignore
tsconfig.json
tsconfig.tsbuildinfo
*.vsix
node_modules/**
esbuild.js
scripts/**
.DS_Store
*.log
# Source maps – only needed during development (watch mode)
dist/extension.js.map
# Compressed webview assets – not needed for VS Code webview delivery
dist/webviews/*.gz
dist/webviews/*.br
dist/webviews/stats.html
