{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Profile",
  "description": "Project-specific configuration for Agent Team v2.0 Kits & Teams system",
  "type": "object",
  "required": ["project", "paths", "commands"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Project identifier (slug)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable project name"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Project version (semver)"
        },
        "description": {
          "type": "string",
          "description": "Project description"
        }
      }
    },
    "technologies": {
      "type": "object",
      "description": "Active tech stack flags for the project. Keys are technology names, values are booleans.",
      "additionalProperties": {
        "type": "boolean"
      },
      "examples": [
        {
          "typescript": true,
          "react": true,
          "vitest": true
        }
      ]
    },
    "paths": {
      "type": "object",
      "description": "Project-specific path placeholders",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "string"
        }
      },
      "examples": [
        {
          "frontend_root": "src",
          "backend_root": "crates/api",
          "tests_root": "src",
          "components": "src/components",
          "docs": "docs"
        }
      ]
    },
    "commands": {
      "type": "object",
      "description": "Project-specific command placeholders",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "string"
        }
      },
      "examples": [
        {
          "test": "pnpm test",
          "test_coverage": "pnpm test -- --coverage",
          "lint": "pnpm lint",
          "backend_test": "cargo test"
        }
      ]
    },
    "context_packs": {
      "type": "array",
      "description": "Pack names available for this project. Each name maps to .agent-teams/context-packs/{name}.md and is synced to all targets. If empty, all packs in the folder are synced.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$"
      },
      "examples": [["architecture", "conventions", "adr"]]
    },
    "agents_md_budget": {
      "type": "integer",
      "description": "Total character budget for standard-tier context packs inlined in AGENTS.md. Essential packs are always inlined regardless of this limit. Defaults to 8000.",
      "minimum": 0,
      "maximum": 100000,
      "default": 8000
    },
    "sync_targets": {
      "type": "array",
      "description": "Target platforms to sync agents to. Defaults to all if omitted.",
      "items": {
        "type": "string",
        "enum": ["claude_code", "codex", "github_copilot", "gemini", "openai", "opencode"]
      },
      "uniqueItems": true
    },
    "gitignore_targets": {
      "type": "array",
      "description": "Targets whose output paths should be added to .gitignore. Only takes effect for targets also listed in sync_targets.",
      "items": {
        "type": "string",
        "enum": ["claude_code", "codex", "github_copilot", "gemini", "openai", "opencode"]
      },
      "uniqueItems": true,
      "default": []
    },
    "workflow_phases": {
      "type": "array",
      "description": "Optional workflow phases enabled for this project. Drives conditional agent generation in team-builder.",
      "items": {
        "type": "string",
        "enum": ["product-refinement", "tdd"]
      },
      "uniqueItems": true,
      "default": []
    },
    "bundled_resources": {
      "type": "object",
      "description": "Controls which bundled agents and skills are materialized across all sync targets (GitHub Copilot, Claude Code, OpenCode)",
      "properties": {
        "agents": {
          "type": "object",
          "description": "Per-agent enable/disable flags. All agents are enabled by default.",
          "properties": {
            "agent-designer": {
              "type": "boolean",
              "default": true,
              "description": "Generates AgentSpec YAML from natural language or imports from other frameworks"
            },
            "consultant": {
              "type": "boolean",
              "default": true,
              "description": "Analyzes agent teams and proposes improvements (skills, MCPs, architectures)"
            },
            "project-configurator": {
              "type": "boolean",
              "default": true,
              "description": "Generates project.profile.yml and context packs from workspace analysis"
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "description": "Per-skill enable/disable flags. All skills are enabled by default.",
          "properties": {
            "agent-spec-authoring": {
              "type": "boolean",
              "default": true,
              "description": "Schema and guidelines for generating valid AgentSpec YAML files"
            },
            "project-spec-authoring": {
              "type": "boolean",
              "default": true,
              "description": "Schema and rules for generating project.profile.yml and context packs"
            }
          },
          "additionalProperties": false
        }
      },
      "default": {
        "agents": {
          "agent-designer": true,
          "consultant": true,
          "project-configurator": true
        },
        "skills": {
          "agent-spec-authoring": true,
          "project-spec-authoring": true
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "Global or agent-specific overrides",
      "properties": {
        "max_chars_per_file": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 50000,
          "description": "Override default max chars per file"
        },
        "output_mode": {
          "type": "string",
          "enum": ["short+diff", "diff", "plan", "structured"],
          "description": "Override default output mode"
        }
      },
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "description": "Agent-specific overrides by agent ID",
          "properties": {
            "max_handoffs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "output_mode": {
              "type": "string",
              "enum": ["short+diff", "diff", "plan", "structured"]
            },
            "max_chars_per_file": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 50000
            }
          }
        }
      }
    }
  }
}
