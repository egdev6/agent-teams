{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://egdev6.dev/schemas/agent.schema.json",
  "title": "GitHub Copilot Agent Schema (VS Code Compatible)",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the agent",
      "minLength": 3,
      "maxLength": 80
    },

    "description": {
      "type": "string",
      "description": "Brief description of the agent's purpose and capabilities",
      "minLength": 10,
      "maxLength": 600
    },

    "tools": {
      "type": "array",
      "description": "Optional list of tools/functions this agent can use",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "default": []
    },

    "welcomeMessage": {
      "type": "string",
      "description": "Optional greeting message when agent is invoked",
      "maxLength": 500
    },

    "_metadata": {
      "type": "object",
      "description": "Agent technical metadata used by Agent Teams tooling.",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["worker", "orchestrator", "router"]
        },
        "domain": {
          "type": "string"
        },
        "subdomains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "intents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "path_globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "object",
          "description": "Execution capabilities (what the agent can do). Empty object means secure defaults.",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "filesystem": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "read": { "type": "boolean", "default": false },
                "write": { "type": "boolean", "default": false }
              }
            },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run": { "type": "boolean", "default": false }
              }
            },
            "network": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fetch": { "type": "boolean", "default": false }
              }
            }
          }
        },
        "skills": {
          "type": "object",
          "description": "Catalog skill references with usage context.",
          "additionalProperties": false,
          "properties": {
            "uses": {
              "type": "array",
              "default": [],
              "description": "Skills from the catalog assigned to this agent, with activation context.",
              "items": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$",
                    "description": "Skill ID referencing an entry in .agent-teams/skills/"
                  },
                  "when": {
                    "type": "string",
                    "description": "Human description of when the agent should invoke this skill"
                  },
                  "tags": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Classification tags to aid routing and discovery"
                  },
                  "autoload": {
                    "type": "boolean",
                    "default": true,
                    "description": "If true, skill content is injected into agent context automatically"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
