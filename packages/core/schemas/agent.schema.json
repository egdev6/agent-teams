{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://egdev6.dev/schemas/agent.schema.json",
  "title": "Agent Teams — Agent Configuration Schema",
  "description": "Flat configuration for an agent. Compiled to an operational MD by the generator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "role", "description"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique technical identifier (slug)",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name",
      "minLength": 3,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "description": "Semver version of this agent config",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "1.0.0"
    },
    "role": {
      "type": "string",
      "description": "Functional role of the agent",
      "enum": ["worker", "orchestrator", "router"]
    },
    "domain": {
      "type": "string",
      "description": "Primary domain (e.g. frontend, backend, testing)",
      "default": "general"
    },
    "subdomain": {
      "type": "string",
      "description": "Optional sub-category within the domain"
    },
    "description": {
      "type": "string",
      "description": "1-3 sentence summary of what this agent does",
      "minLength": 10,
      "maxLength": 600
    },
    "expertise": {
      "type": "array",
      "description": "Knowledge areas this agent specialises in (used for team routing/selection)",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "intents": {
      "type": "array",
      "description": "Canonical intent identifiers this agent handles (snake_case). Used by routers.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "default": []
    },
    "scope": {
      "type": "object",
      "description": "Operational scope — what the agent manages and what it does not touch",
      "additionalProperties": false,
      "properties": {
        "topics": {
          "type": "array",
          "description": "Responsibility topics (human-readable)",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "path_globs": {
          "type": "array",
          "description": "File patterns the agent operates on, with optional priority",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": ["pattern"],
                "additionalProperties": false,
                "properties": {
                  "pattern": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "enum": ["high", "medium", "low"],
                    "default": "medium"
                  }
                }
              }
            ]
          },
          "default": []
        },
        "excludes": {
          "type": "array",
          "description": "Patterns explicitly out of scope",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "workflow": {
      "type": "array",
      "description": "Ordered execution steps. Extends or replaces the role's base workflow. Each item is an imperative step string.",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tools": {
      "type": "array",
      "description": "Environment capabilities / integrations the agent can invoke",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "description": "Condition or context for using this tool"
          }
        }
      },
      "default": []
    },
    "skills": {
      "type": "array",
      "description": "Reusable procedures / recipes from the skills registry",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "when": {
            "type": "string",
            "description": "When to invoke this skill"
          }
        }
      },
      "default": []
    },
    "permissions": {
      "type": "object",
      "description": "What the agent is allowed to do at runtime. All default to false (secure).",
      "additionalProperties": false,
      "properties": {
        "can_create_files": {
          "type": "boolean",
          "default": false
        },
        "can_edit_files": {
          "type": "boolean",
          "default": false
        },
        "can_delete_files": {
          "type": "boolean",
          "default": false
        },
        "can_run_commands": {
          "type": "boolean",
          "default": false
        },
        "can_delegate": {
          "type": "boolean",
          "default": false
        },
        "can_modify_public_api": {
          "type": "boolean",
          "default": false
        },
        "can_touch_global_config": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "Behavioural rules for the agent",
      "additionalProperties": false,
      "properties": {
        "always": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "escalate": {
          "type": "array",
          "description": "Conditions that must trigger escalation to a higher-level agent",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "handoffs": {
      "type": "object",
      "description": "Agent coordination topology",
      "additionalProperties": false,
      "properties": {
        "receives_from": {
          "type": "array",
          "description": "Agent IDs or role names that can send tasks to this agent",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "delegates_to": {
          "type": "array",
          "description": "Agent IDs this agent can delegate sub-tasks to",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "escalates_to": {
          "type": "array",
          "description": "Agent IDs this agent escalates blocked tasks to",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "output": {
      "type": "object",
      "description": "Response format configuration",
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "diff",
            "code-review",
            "planning",
            "analysis",
            "step-by-step",
            "structured-qa",
            "summary",
            "routing-decision",
            "custom"
          ],
          "default": "diff"
        },
        "extends": {
          "type": "string",
          "description": "Base template to extend (used when customising sections)",
          "enum": [
            "diff",
            "code-review",
            "planning",
            "analysis",
            "step-by-step",
            "structured-qa",
            "summary",
            "routing-decision"
          ]
        },
        "sections": {
          "type": "array",
          "description": "Ordered section list overriding the base template",
          "items": {
            "type": "string"
          }
        },
        "format_instructions": {
          "type": "string",
          "description": "Free-form instructions used when template=custom"
        },
        "mode": {
          "type": "string",
          "enum": ["short", "detailed"],
          "default": "short"
        },
        "max_items": {
          "type": "integer",
          "description": "Maximum items per section in the response",
          "minimum": 1,
          "default": 5
        },
        "never_include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["disclaimers", "apologies", "placeholders"]
        }
      }
    },
    "context_packs": {
      "type": "array",
      "description": "Context pack IDs to load at runtime (not rendered in MD)",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9:_-]+$"
      },
      "default": []
    },
    "context_strategy": {
      "type": "object",
      "description": "Runtime context loading configuration (not rendered in MD)",
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "max_chars_per_file": {
          "type": "integer",
          "minimum": 100,
          "default": 4000
        },
        "retrieval_mode": {
          "type": "string",
          "enum": ["semantic", "glob", "explicit"],
          "default": "semantic"
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "Platforms this agent syncs to (not rendered in MD)",
      "items": {
        "type": "string",
        "enum": ["copilot", "claude"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["copilot", "claude"]
    },
    "_legacy": {
      "type": "object",
      "description": "Deprecated _metadata fields kept temporarily for migration",
      "additionalProperties": true
    }
  }
}
